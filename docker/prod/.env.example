# cp docker/prod/.env.example docker/prod/.env して使う
# パスワードは必ず強力なものに差し替えること

WEB_PORT=3000

POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=appdb
# POSTGRES_PORT=5432   # 外部公開が必要な場合のみ

DATABASE_URL=postgres://app:CHANGE_ME_STRONG_PASSWORD@db:5432/appdb

NODE_ENV=production
