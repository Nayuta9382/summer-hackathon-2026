{
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "3.9.6"
  },
  "scripts": {
    "format": "prettier --write \"app/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"app/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "app/**/*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.10"
  }
}
